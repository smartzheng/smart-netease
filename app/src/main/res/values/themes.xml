<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 纯 Compose 应用：XML 主题负责首帧前的窗口底与系统栏外观。 -->
    <style name="Base.Theme.Ncrust" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_window_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Ncrust" parent="Base.Theme.Ncrust" />
</resources>
